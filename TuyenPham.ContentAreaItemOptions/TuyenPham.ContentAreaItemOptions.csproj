<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>

    <!-- NuGet package metadata -->
    <PackageId>TuyenPham.ContentAreaItemOptions</PackageId>
    <Version>4.0.1</Version>
    <Title>Content Area Item Options</Title>
    <Authors>Tuyen Pham</Authors>
    <Description>Plugin to add options to content area items in Optimizely.</Description>
    <PackageProjectUrl>https://github.com/precise-alloy/content-area-item-options</PackageProjectUrl>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>Optimizely Content Area Item Options</PackageTags>
    <Copyright>Copyright 2026</Copyright>

    <!-- Prevent ClientResources from being included as compiled content -->
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TuyenPham.ContentAreaItemOptions.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EPiServer.CMS.UI.Core" Version="13.1.1" />
  </ItemGroup>

  <!-- Zip ClientResources + module.config before packing.
       Paths are literal because IntermediateOutputPath is not yet defined during evaluation,
       and the zip has to be addressable from the static <None Include> below. -->
  <PropertyGroup>
    <ModuleName>TuyenPham.ContentAreaItemOptions</ModuleName>
    <ModuleZipPath>$(MSBuildProjectDirectory)/obj/$(ModuleName).zip</ModuleZipPath>
    <ModuleStagingDir>$(MSBuildProjectDirectory)/obj/module-staging/</ModuleStagingDir>
  </PropertyGroup>

  <Target Name="CreateModuleZip" BeforeTargets="GenerateNuspec" DependsOnTargets="Build">
    <ItemGroup>
      <ModuleFiles Include="ClientResources/**/*.*" />
    </ItemGroup>

    <!-- Client resources live under a version folder so upgrades bust the browser cache. -->
    <PropertyGroup>
      <ModuleConfigContent>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/module.config'))</ModuleConfigContent>
      <ModuleConfigContent>$(ModuleConfigContent.Replace('clientResourceRelativePath=&quot;ClientResources&quot;', 'clientResourceRelativePath=&quot;$(Version)/ClientResources&quot;'))</ModuleConfigContent>
    </PropertyGroup>

    <MakeDir Directories="$(ModuleStagingDir)" />
    <WriteLinesToFile File="$(ModuleStagingDir)module.config" Lines="$([MSBuild]::Escape($(ModuleConfigContent)))" Overwrite="true" />
    <Copy SourceFiles="@(ModuleFiles)" DestinationFiles="@(ModuleFiles->'$(ModuleStagingDir)$(Version)/%(Identity)')" />
    <ZipDirectory SourceDirectory="$(ModuleStagingDir)" DestinationFile="$(ModuleZipPath)" Overwrite="true" />
    <RemoveDir Directories="$(ModuleStagingDir)" />
  </Target>

  <!-- Include zip as contentFiles in NuGet package -->
  <ItemGroup>
    <None Include="$(ModuleZipPath)" Pack="true" PackagePath="contentFiles/any/any/modules/_protected/$(ModuleName)" Visible="false" />
    <None Include="../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <!-- Include .targets file for consuming projects -->
  <ItemGroup>
    <None Include="TuyenPham.ContentAreaItemOptions.targets" Pack="true" PackagePath="build/net10.0/" Visible="false" />
    <None Include="TuyenPham.ContentAreaItemOptions.targets" Pack="true" PackagePath="buildTransitive/net10.0/" Visible="false" />
  </ItemGroup>

  <PropertyGroup>
    <ContentTargetFolders>contentFiles</ContentTargetFolders>
  </PropertyGroup>

</Project>
